# Database
DB_PASSWORD=changeme_dev

# Host port for the webapp container (default 80). Override locally if port 80
# is already taken on your machine — do not change the default in docker-compose.yml.
# WEBAPP_PORT=8080

# JWT — generate secret with: openssl rand -hex 32
# WARNING: the app refuses to start if JWT_SECRET contains "changeme" or is shorter than 32 chars
# (this default deliberately contains "changeme" so an unedited copy fails to start)
JWT_SECRET=changeme_generate_with_openssl_rand_hex_32
JWT_EXPIRE_HOURS=1

# bcrypt work factor (default 12, max 14 — each step doubles the time per login;
# 12 ≈ 0.3 s, 14 ≈ 1.2 s on the pilot hardware)
BCRYPT_ROUNDS=12

# Ausführlichkeit des Logs in api und worker (DEBUG/INFO/WARNING/ERROR).
# Gilt nur fuer die Logger dieses Systems -- Bibliotheken wie httpx bleiben auf
# WARNING, sonst schriebe DEBUG eine Zeile pro Provider-Aufruf. Ein unbrauchbarer
# Wert faellt auf INFO zurueck und sagt das in der ersten Logzeile.
# LOG_LEVEL=INFO

# Erlaubte CORS-Origins, kommagetrennt. Leer lassen -- weder der ausgelieferte
# Stack noch die Entwicklung braucht einen CORS-Header: nginx liefert SPA und API
# unter derselben Origin aus, und der Vite-Dev-Server proxyt /api auf nginx
# (frontend/vite.config.ts). Die Zeile ist fuer den Fall vorgesehen, dass ein
# Frontend einmal unter einer eigenen Origin laeuft.
# CORS_ALLOW_ORIGINS=https://app.example.org

# LLM Provider — MVP: OpenAI Direct (keine echten internen Dokumente)
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# Post-MVP: Azure OpenAI EU — uncomment and set before first real internal document
# LITELLM_BASE_URL=https://<resource>.openai.azure.com/
# LITELLM_API_VERSION=2024-02-01
# LITELLM_API_KEY=<azure-key>
